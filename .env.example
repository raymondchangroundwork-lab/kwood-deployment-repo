# ==============================================================================
# K-Wood Kitchens Quotation Builder — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your setup.
# IMPORTANT: .env is git-ignored — NEVER commit .env to Git.

# ------------------------------------------------------------------------------
# 1. Administrator Account Setup
# ------------------------------------------------------------------------------
# When you start the server (npm start), it will automatically ensure this admin
# account exists in the SQLite database and set its password to what is defined below.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_123
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@kwoodkitchens.local

# ------------------------------------------------------------------------------
# 2. Server Network Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. Database & Storage Configuration
# ------------------------------------------------------------------------------
# Local SQLite database file path (must be stored locally outside of Git)
DB_PATH=D:\Kwood\Data\kwood.db

# Directory where timestamped database backups are stored (npm run backup)
BACKUP_DIR=D:\Kwood\Backups

# ------------------------------------------------------------------------------
# 4. Session Security
# ------------------------------------------------------------------------------
# Session lifetime in hours (default: 12 hours)
SESSION_TTL_HOURS=12
